# ==========================================
# 奇奇方块学院 QiqiCraft Academy 环境配置
# ==========================================

# 1. OpenAI 视觉识别大模型配置（必填）
# 支持官方 key 或中转代理服务（如 aiproxy 等）
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# 2. 家长控制台进入密码（纯数字或字符，默认 1234）
PARENT_PIN=1234

# 3. 小朋友昵称
CHILD_NAME=小矿工奇奇

# 4. 服务监听端口（默认 3001）
PORT=3001
