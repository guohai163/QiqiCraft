# ==========================================
# 淇淇方块学院 QiqiCraft Academy 环境配置
# ==========================================

# 1. OpenAI 视觉识别大模型配置（必填）
# 支持官方 key 或中转代理服务（如 aiproxy 等）
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# 2. 家长控制台进入密码（纯数字或字符，默认 1234）
PARENT_PIN=1234

# 3. 小朋友昵称和性别 (boy 或 girl)
CHILD_NAME=小矿工淇淇
CHILD_GENDER=boy

# 4. 每日《我的世界》建造游玩限时（单位：分钟，默认 60 分钟）
DAILY_WORLD_MINUTES=60

# 5. 微软免费语音朗读发音人（可选，默认 zh-CN-XiaoxiaoNeural，可选 zh-CN-XiaoyiNeural / zh-CN-YunxiNeural）
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural

# 6. 服务监听端口（默认 3001）
PORT=3001
